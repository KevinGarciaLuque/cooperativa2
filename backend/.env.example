# Copia este archivo como .env y completa los valores. NUNCA subas el .env real a git.

# Base de datos
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cooperativa

# Seguridad: cadena larga y aleatoria (por ejemplo: openssl rand -hex 48)
JWT_SECRET=

# Servidor
PORT=5000
FRONTEND_URL=http://localhost:5173
# Orígenes adicionales permitidos por CORS, separados por coma (opcional)
CORS_ORIGINS=

# Correo para recuperación de contraseña y avisos (opcional)
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=

# Zona horaria de la cooperativa (por defecto America/Tegucigalpa)
APP_TIMEZONE=America/Tegucigalpa
# Opcional: fija la zona de cada sesión de MySQL (ej. -06:00). Úsalo solo en bases nuevas.
DB_TIMEZONE=

# Registros: debug | info | warn | error
LOG_LEVEL=info

# Pruebas automáticas: base aparte, SIEMPRE terminada en _test
TEST_DB_NAME=cooperativa_test
